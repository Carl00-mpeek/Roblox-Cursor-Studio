{
  "name": "rbx-cursor-studio",
  "version": "4.5.5",
  "description": "RBX Cursor Studio - Roblox imleç düzenleyici (Electron sürümü)",
  "main": "main/main.js",
  "author": "Carl",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/build-native.js",
    "predist": "node scripts/build-native.js --require",
    "dist": "electron-builder",
    "test": "node tests/run.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.rbxcursorstudio.app",
    "productName": "RBX Cursor Studio",
    "copyright": "Copyright (c) 2026 Demhat Dayan. Licensed under PolyForm Noncommercial 1.0.0.",
    "asar": true,
    "asarUnpack": [
      "assets/backgrounds/**/*",
      "assets/originals/**/*"
    ],
    "extraResources": [
      {
        "from": "native",
        "to": "native",
        "filter": [
          "cursor_helper.exe"
        ]
      }
    ],
    "compression": "normal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map",
      "!native/*.cpp",
      "!native/build.bat"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/backgrounds/logo.ico",
      "fileAssociations": [
        {
          "ext": "rbxcursor",
          "name": "RBX Cursor Studio Paketi",
          "description": "RBX Cursor Studio paylaşılabilir imleç paketi",
          "icon": "assets/backgrounds/logo.ico",
          "role": "Editor"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "RBX-Cursor-Studio-Kurulum-${version}.${ext}"
    },
    "portable": {
      "artifactName": "RBX-Cursor-Studio-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Carl00-mpeek",
        "repo": "Roblox-Cursor-Studio"
      }
    ]
  }
}
